# Clés API
ANTHROPIC_API_KEY=
BOT_TOKEN=

# Modèles Claude (valeurs par défaut ci-dessous, laisser vide pour les garder)
CLAUDE_MODEL_HAIKU=claude-haiku-5-5
CLAUDE_MODEL_SONNET=claude-sonnet-5-5
CLAUDE_MODEL_OPUS=claude-opus-5-5

# Configuration Redis
# Mettre à false pour désactiver Redis (mode local sans persistance des conversations GPT-Helper)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# Configuration des ID de forum pour la réponse automatique
AUTO_REPLY_FORUM_IDS=

# Configuration des rôles pour les commandes (IDs séparés par des virgules)
ASK_GPT_UNAUTHORIZED_ROLE_IDS=
RESUME_AUTHORIZED_ROLE_IDS=
# Rôles autorisés à utiliser le tag de forum "Opus"
OPUS_ROLE_IDS=
# Rôles admin : /usage d'un autre membre, /unindex, /debug_redis (le créateur du bot l'est toujours)
ADMIN_ROLE_IDS=

# Budget mensuel par utilisateur, en USD (le créateur du bot n'a aucune limite)
# Au-delà de SOFT : tout passe en Haiku (effort low). Au-delà de HARD : plus de réponse.
BUDGET_SOFT_USD=5
BUDGET_HARD_USD=8

# Base SQLite des usages (à placer sur un volume pour survivre aux redéploiements)
USAGE_DB_PATH=data/usage.db

# ID du canal de log pour la commande resume
RESUME_LOG_CHANNEL_ID=
